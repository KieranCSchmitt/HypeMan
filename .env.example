# Local gateway. OAuth credentials stay in the gateway, never in extension storage.
PORT=8787

# Explicit demo fixtures; npm run demo also sets this to 1.
# Set 0 and run npm start, then Continue with ChatGPT in extension Settings.
DEMO_MODE=0

# Advanced: optional internal transport secret, 16–256 printable non-space characters.
# Leave blank for automatic connection using the private .hypeman-token file.
# Never copy this into the interface. Legacy BURROW_TOKEN/.burrow-token remain compatible.
HYPEMAN_TOKEN=

# Live AI uses ChatGPT sign-in only, from onboarding or Control Center → Settings.
# No model downloads or provider API keys are needed.
# Optional preferred model; the signed-in account's available catalog is authoritative.
CHATGPT_MODEL=gpt-6-astra

# Optional YouTube transcript service. Native captions need no service key.
SUPADATA_API_KEY=

# Server request deadline, milliseconds (1,000–300,000).
REQUEST_DEADLINE_MS=90000
