{
  "name": "hypeman-browser-companion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "HypeMan, a Y2K browser task companion powered by ChatGPT sign-in.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n gateway,extension \"tsx watch apps/gateway/src/index.ts\" \"node scripts/build.mjs --watch\"",
    "demo": "DEMO_MODE=1 tsx apps/gateway/src/index.ts",
    "start": "tsx apps/gateway/src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "openai": "^7.20.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spectrum-ts": "12.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
